{
  "expo": {
    "name": "Think Different",
    "slug": "verses-mobile",
    "version": "1.0.0",
    "scheme": "thinkdifferent",
    "orientation": "portrait",
    "icon": "./assets/enhanced_image.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow Think Different to save wallpapers to your photo library."
      }
    },
    "android": {
      "package": "com.thinkdifferent.verses",
      "adaptiveIcon": {
        "foregroundImage": "./assets/enhanced_image.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Think Different to save wallpapers to your photo library.",
          "savePhotosPermission": "Allow Think Different to save wallpapers to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fe071e2-4647-44c0-9c8b-fed875c2bca5"
      }
    }
  }
}
